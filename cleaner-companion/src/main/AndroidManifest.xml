<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <permission
        android:name="devcat.catboard.permission.CLEAN_TRANSCRIPT"
        android:protectionLevel="signature" />

    <application android:label="CatBoard Cleaner" android:allowBackup="false">
        <activity android:name=".CleanerSettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".TranscriptCleanerService"
            android:exported="true"
            android:permission="devcat.catboard.permission.CLEAN_TRANSCRIPT" />
    </application>
</manifest>
